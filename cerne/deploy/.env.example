# ===== Cerne · configuração de produção =====
# Copie para .env (chmod 600) e preencha. Nunca versione o .env.

# Domínio público (o DNS do tipo A deve apontar para o IP da VPS antes de subir)
CERNE_DOMAIN=cerne.seudominio.com.br
ACME_EMAIL=voce@seudominio.com.br

# Gere com:  openssl rand -base64 32 | tr -d '/+=' | cut -c1-32
POSTGRES_PASSWORD=
# Gere com:  openssl rand -hex 32
ADMIN_TOKEN=
# Gere com:  openssl rand 32 | base64 | tr '+/' '-_'
# GUARDE UMA CÓPIA FORA DA VPS: sem ela as credenciais de ERP cifradas não podem ser lidas.
CERNE_MASTER_KEY=

# IPs que podem usar /v1/admin (separados por espaço). Padrão: qualquer IP.
ADMIN_ALLOW_IPS=0.0.0.0/0 ::/0

# Ajustes
WEB_CONCURRENCY=2
RATE_LIMIT_PER_MIN=240
DOCS_ENABLED=true
LOG_LEVEL=INFO

# Backup diário
BACKUP_DIR=./backups
BACKUP_KEEP_DAYS=14
BACKUP_HOUR=3

# Worker de sincronização (perfil "sync"). Arquivos em deploy/config/ aparecem em /app/config/local/
SYNC_INTERVAL_HOURS=24
FIELD_MAP=/app/config/local/field_map.json
SERVICE_MAP=/app/config/local/service_map.json
# "sim" para subir também o worker de sincronização com o ERP no deploy.sh
ATIVAR_SYNC=nao
