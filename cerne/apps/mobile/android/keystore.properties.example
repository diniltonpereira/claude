# Copie para keystore.properties (NÃO versionar) ou use as variáveis CERNE_STOREFILE, CERNE_STOREPASSWORD,
# CERNE_KEYALIAS e CERNE_KEYPASSWORD. Gerar a chave de upload (guarde-a com cuidado, é permanente):
#   keytool -genkeypair -v -keystore cerne-upload.jks -alias cerne -keyalg RSA -keysize 4096 -validity 10000
storeFile=/caminho/para/cerne-upload.jks
storePassword=
keyAlias=cerne
keyPassword=
