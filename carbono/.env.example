# Copie para .env e preencha. Nunca versione o .env.
CARBONO_MODO=producao
# Segredo aleatório (mín. 32 caracteres): python -c "import secrets; print(secrets.token_urlsafe(48))"
CARBONO_SEGREDO=
CARBONO_URL_PUBLICA=https://carbonmg.exemplo.mg.gov.br
# IP do proxy reverso que repassa X-Forwarded-For (no compose, a rede do Docker)
CARBONO_PROXY_IPS=*
PLATAFORMA_NOME=CarbonMG
CARBONO_TAXA_MARKETPLACE=10

# LGPD
CARBONO_CONTROLADOR=Prefeitura Municipal de ... (CNPJ ...)
CARBONO_ENCARREGADO=Nome do encarregado — dpo@exemplo.mg.gov.br
CARBONO_TERMOS_VERSAO=2026-1

# Login gov.br (credenciais obtidas pelo órgão no processo de integração)
GOVBR_URL=https://sso.staging.acesso.gov.br
GOVBR_CLIENT_ID=
GOVBR_CLIENT_SECRET=
GOVBR_REDIRECT_URI=https://carbonmg.exemplo.mg.gov.br/auth/govbr/retorno

# E-mail (convites, lembretes do dia 10, alertas ao fiscal, notificações formais, avisos de segurança).
# Use o SMTP do órgão ou um serviço contratado. Sem isso, as mensagens ficam na fila do sistema.
CARBONO_SMTP_HOST=
CARBONO_SMTP_PORTA=587
# starttls (porta 587) | ssl (porta 465) | nenhuma (só para relay interno de confiança)
CARBONO_SMTP_SEGURANCA=starttls
CARBONO_SMTP_USUARIO=
CARBONO_SMTP_SENHA=
CARBONO_SMTP_REMETENTE=CarbonMG <nao-responda@exemplo.mg.gov.br>
# O `servir` entrega a fila a cada minuto. Use 0 para entregar só pelo cron (`enviar-emails`).
# CARBONO_ENVIO_AUTOMATICO=0

# Antivírus dos anexos (ClamAV). No compose já aponta para o serviço "clamav".
# Fora do compose: host:porta do clamd ou caminho do socket Unix.
# CARBONO_CLAMAV=127.0.0.1:3310
# Obrigatório em produção (falha fechada). Só desligue por decisão registrada:
# CARBONO_ANTIVIRUS=desativado
