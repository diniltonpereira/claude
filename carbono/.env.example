# Copie para .env e preencha. Nunca versione o .env.
CARBONO_MODO=producao
# Segredo aleatório (mín. 32 caracteres): python -c "import secrets; print(secrets.token_urlsafe(48))"
CARBONO_SEGREDO=
CARBONO_URL_PUBLICA=https://carbonmg.exemplo.mg.gov.br
# IP do proxy reverso que repassa X-Forwarded-For (no compose, a rede do Docker)
CARBONO_PROXY_IPS=*
PLATAFORMA_NOME=CarbonMG
CARBONO_TAXA_MARKETPLACE=10

# LGPD
CARBONO_CONTROLADOR=Prefeitura Municipal de ... (CNPJ ...)
CARBONO_ENCARREGADO=Nome do encarregado — dpo@exemplo.mg.gov.br
CARBONO_TERMOS_VERSAO=2026-1

# Login gov.br (credenciais obtidas pelo órgão no processo de integração)
GOVBR_URL=https://sso.staging.acesso.gov.br
GOVBR_CLIENT_ID=
GOVBR_CLIENT_SECRET=
GOVBR_REDIRECT_URI=https://carbonmg.exemplo.mg.gov.br/auth/govbr/retorno
